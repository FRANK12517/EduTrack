[Unit]
Description=EduTrack production service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edutrack
Group=edutrack
WorkingDirectory=/opt/edutrack
EnvironmentFile=/etc/edutrack/production.env
ExecStart=/usr/bin/node /opt/edutrack/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/edutrack/data

[Install]
WantedBy=multi-user.target
